<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.AdminDashboardController">

    <padding>
        <Insets top="40" bottom="40" left="80" right="80"/>
    </padding>

    <Label text="Admin Dashboard"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Select a section to manage"
           style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>

    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">

        <VBox spacing="10" alignment="CENTER">
            <Button text="Manage Customers"
                    onAction="#handleCustomers"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px;"/>
            <Button text="Manage Orders"
                    onAction="#handleOrders"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px;"/>
            <Button text="Reports and Sorting"
                    onAction="#handleReports"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px;"/>
            <Button text="Save Data"
                    onAction="#handleSave"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px; -fx-background-color: #27ae60; -fx-text-fill: white;"/>
        </VBox>

        <VBox spacing="10" alignment="CENTER">
            <Button text="Manage Restaurants"
                    onAction="#handleRestaurants"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px;"/>
            <Button text="Manage Riders"
                    onAction="#handleRiders"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px;"/>
            <Button text="Manage Rest. Admins"
                    onAction="#handleRestAdmins"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px;"/>
            <Button text="Load Data"
                    onAction="#handleLoad"
                    prefWidth="180" prefHeight="45"
                    style="-fx-font-size: 13px; -fx-background-color: #2980b9; -fx-text-fill: white;"/>
        </VBox>

    </HBox>

    <Label fx:id="messageLabel"
           style="-fx-font-size: 12px; -fx-text-fill: #27ae60;"
           text=""/>

    <Button text="Logout"
            onAction="#handleLogout"
            prefWidth="180" prefHeight="40"
            style="-fx-font-size: 13px; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>

</VBox>