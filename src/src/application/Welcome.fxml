<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.WelcomeController">

    <padding>
        <Insets top="60" bottom="60" left="80" right="80"/>
    </padding>

    <Label text="Food Delivery System"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Please select an option to continue"
           style="-fx-font-size: 14px; -fx-text-fill: #555555;"/>

    <VBox spacing="12" alignment="CENTER" style="-fx-padding: 30 0 0 0;">

        <Button text="Admin Login"
                fx:id="adminLoginBtn"
                onAction="#handleAdminLogin"
                prefWidth="220" prefHeight="45"
                style="-fx-font-size: 14px;"/>

        <Button text="User Login"
                fx:id="userLoginBtn"
                onAction="#handleUserLogin"
                prefWidth="220" prefHeight="45"
                style="-fx-font-size: 14px;"/>

        <Button text="Exit"
                fx:id="exitBtn"
                onAction="#handleExit"
                prefWidth="220" prefHeight="45"
                style="-fx-font-size: 14px; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>

    </VBox>

</VBox>