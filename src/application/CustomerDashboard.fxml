<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox spacing="10"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.CustomerDashboardController">

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="Customer Dashboard"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label fx:id="welcomeLabel"
               style="-fx-font-size: 15px; -fx-text-fill: #2980b9;"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="balanceLabel"
               style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
        <TextField fx:id="amountField"
                   promptText="Amount" prefWidth="120"/>
        <Button text="Add Money" onAction="#handleAddMoney"/>
        <Button text="Withdraw Money" onAction="#handleWithdraw"/>
    </HBox>

    <!-- Place order controls -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="orderCodeField" promptText="Order code" prefWidth="100"/>
        <TextField fx:id="restaurantCodeField" promptText="Restaurant code" prefWidth="130"/>
        <TextField fx:id="basePriceField" promptText="Base price" prefWidth="100"/>
        <TextField fx:id="dayField" promptText="Day" prefWidth="60"/>
        <TextField fx:id="monthField" promptText="Month" prefWidth="60"/>
        <TextField fx:id="yearField" promptText="Year" prefWidth="70"/>
        <Button text="Place Order" onAction="#handlePlaceOrder"/>
    </HBox>

    <!-- Orders TableView -->
    <Label text="My Orders:"
           style="-fx-font-weight: bold;"/>
    <TableView fx:id="ordersTable" prefHeight="200">
        <columns>
            <TableColumn fx:id="orderCodeCol" text="Code" prefWidth="60"/>
            <TableColumn fx:id="restaurantCol" text="Restaurant" prefWidth="150"/>
            <TableColumn fx:id="finalPriceCol" text="Final Price" prefWidth="90"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="90"/>
            <TableColumn fx:id="dateCol" text="Date" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Action buttons -->
    <HBox spacing="10">
        <Button text="My Orders" onAction="#handleMyOrders"/>
        <Button text="Restaurants I Ordered From" onAction="#handleMyRestaurants"/>
        <Button text="Premium Restaurants" onAction="#handlePremiumRestaurants"/>
        <Button text="Search Restaurant by Code" onAction="#handleSearchRestaurant"/>
        <Button text="Update My Details" onAction="#handleUpdateDetails"/>
    </HBox>

    <Label fx:id="messageLabel"
           style="-fx-font-size: 12px;"
           text="" wrapText="true"/>

    <Button text="Logout"
            onAction="#handleLogout"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>

</VBox>